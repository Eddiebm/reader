OPENAI_API_KEY=

# LLM for /api/claude — set ONE path:
# Recommended: OpenRouter (single key, pick model via OPENROUTER_MODEL)
OPENROUTER_API_KEY=
# e.g. anthropic/claude-sonnet-4 — see https://openrouter.ai/models
OPENROUTER_MODEL=
# Optional; OpenRouter asks for Referer on some tiers
# OPENROUTER_HTTP_REFERER=https://your-production-domain.vercel.app

# Or direct Anthropic (ignored if OPENROUTER_API_KEY is set)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
